---
import skills from '../data/skills.json';
import { ui, fmt, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const s = t.skills;

const categories = [
  { id: 'frontend', icon: '🎨' },
  { id: 'backend', icon: '⚙️' },
  { id: 'database', icon: '🗄️' },
  { id: 'devops', icon: '🐳' },
  { id: 'cloud', icon: '☁️' },
  { id: 'tools', icon: '🛠️' },
];

const groups = categories
  .map((c) => ({ ...c, label: s.categories[c.id], items: skills.filter((k) => k.category === c.id) }))
  .filter((g) => g.items.length > 0);

const totalXp = skills.reduce((sum, k) => sum + k.xp, 0);
const fmtNum = (n: number) => n.toLocaleString(t.meta.numberLocale);

const rank = (level: number) =>
  level >= 90 ? s.ranks.master : level >= 80 ? s.ranks.veteran : level >= 70 ? s.ranks.adept : s.ranks.apprentice;
---

<section id="skills" class="section-container bg-game-dark-light/40" aria-labelledby="skills-heading">
  <div class="mx-auto max-w-6xl">
    <div class="reveal">
      <h2 id="skills-heading" class="heading-pixel mb-6">
        <span aria-hidden="true">⚔️</span> {s.heading} <span aria-hidden="true">⚔️</span>
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-muted">
        {fmt(s.introPre, { n: skills.length })}
        <strong class="text-game-cyan">{fmtNum(totalXp)} XP</strong>
        {s.introPost}
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
      {groups.map((group) => (
        <li class="reveal">
          <article class="glass-panel h-full rounded-xl p-5" aria-labelledby={`cat-${group.id}`}>
            <h3 id={`cat-${group.id}`} class="mb-5 flex items-center gap-2 font-pixel text-xs text-game-cyan">
              <span aria-hidden="true">{group.icon}</span>
              {group.label}
            </h3>

            <ul class="space-y-5" role="list">
              {group.items.map((skill) => (
                <li class="skill">
                  <div class="mb-1.5 flex items-baseline justify-between gap-2">
                    <span class="font-semibold text-ink">{skill.name}</span>
                    <span class="font-pixel text-[0.6rem] text-game-purple" aria-hidden="true">
                      {s.lvl} <span class="lvl-num" data-target={skill.level}>{skill.level}</span>
                    </span>
                  </div>

                  <div
                    class="skill-track"
                    role="meter"
                    aria-label={fmt(s.meter, { name: skill.name, level: skill.level, rank: rank(skill.level) })}
                    aria-valuenow={skill.level}
                    aria-valuemin="0"
                    aria-valuemax="100"
                  >
                    <div class="skill-fill" style={`--w:${skill.level}%`}></div>
                  </div>

                  <p class="mt-1 text-right font-pixel text-[0.55rem] text-muted" aria-hidden="true">
                    {rank(skill.level)} · {fmtNum(skill.xp)} XP
                  </p>
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .skill-track {
    height: 14px;
    overflow: hidden;
    background: var(--surface-2);
    border: 2px solid var(--border);
  }

  .skill-fill {
    height: 100%;
    width: var(--w);
    background: linear-gradient(90deg, var(--blue), var(--accent), var(--purple));
    background-size: 200% 100%;
  }

  :global(.js) .skill-fill {
    width: 0;
    transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.js) .skill-fill.in {
    width: var(--w);
  }
</style>

<script>
  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fills = document.querySelectorAll<HTMLElement>('.skill-fill');

  function motionOff() {
    return reduce || root.classList.contains('no-motion');
  }

  function fill(el: HTMLElement) {
    el.classList.add('in');
    const num = el.closest('.skill')?.querySelector<HTMLElement>('.lvl-num');
    if (!num) return;
    const target = Number(num.dataset.target ?? 0);

    if (motionOff()) {
      num.textContent = String(target);
      return;
    }

    const start = performance.now();
    const duration = 1200;
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      num.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  if (!('IntersectionObserver' in window)) {
    fills.forEach((f) => f.classList.add('in'));
  } else {
    if (!motionOff()) {
      document.querySelectorAll<HTMLElement>('.lvl-num').forEach((n) => (n.textContent = '0'));
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            fill(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    fills.forEach((f) => io.observe(f));
  }
</script>