---
import { ui, type Lang } from '../i18n/ui';
import { getData } from '../i18n/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const q = t.quests;
const quests = getData(lang).experience;
---

<section id="experience" class="section-container" aria-labelledby="experience-heading">
  <div class="mx-auto max-w-4xl">
    <div class="reveal">
      <h2 id="experience-heading" class="heading-pixel mb-6">
        <span aria-hidden="true">🎯</span> {q.heading} <span aria-hidden="true">🎯</span>
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-muted">{q.intro}</p>
    </div>

    <ol class="timeline" role="list">
      {quests.map((item) => (
        <li class="reveal timeline-item">
          <span class="timeline-node" aria-hidden="true">{item.icon}</span>

          <article class="glass-panel rounded-xl p-5 sm:p-6" aria-labelledby={`quest-${item.id}`}>
            <div class="mb-3 flex flex-wrap items-center gap-2">
              <span class={`badge ${item.status === 'active' ? 'badge-active' : 'badge-done'}`}>
                {item.status === 'active' ? q.active : q.done}
              </span>
              <span class="font-pixel text-[0.6rem] text-muted">
                {item.type === 'work' ? q.main : q.training}
              </span>
            </div>

            <h3 id={`quest-${item.id}`} class="text-xl font-bold text-ink">{item.role}</h3>
            <p class="mt-1 font-semibold text-game-cyan">{item.org}</p>
            <p class="mb-3 text-sm text-muted">{item.period}</p>

            <p class="mb-3 text-muted">{item.summary}</p>

            {item.highlights.length > 0 && (
              <ul class="mb-4 list-disc space-y-1.5 pl-5 text-sm text-muted marker:text-game-cyan">
                {item.highlights.map((h: string) => <li>{h}</li>)}
              </ul>
            )}

            <ul class="flex flex-wrap gap-2" role="list" aria-label={q.techs}>
              {item.tags.map((tag) => <li class="chip">{tag}</li>)}
            </ul>

            {item.url && (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex min-h-[44px] items-center gap-2 font-semibold text-game-cyan underline underline-offset-4 hover:text-game-cyan-light"
              >
                {item.urlLabel}
                <span aria-hidden="true">↗</span>
                <span class="sr-only">{t.newTab}</span>
              </a>
            )}
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    padding-left: 3.25rem;
    display: grid;
    gap: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 1.3rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 4px;
    background: repeating-linear-gradient(to bottom, var(--blue) 0 10px, transparent 10px 18px);
  }

  .timeline-item { position: relative; }

  .timeline-node {
    position: absolute;
    left: -3.25rem;
    top: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.25rem;
    background: var(--surface);
    border: 3px solid var(--accent);
    border-radius: 0.5rem;
    box-shadow: var(--glow);
  }

  .badge {
    padding: 0.25rem 0.6rem;
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    border: 2px solid currentColor;
  }
  .badge-active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .badge-done { color: var(--muted); }

  .chip {
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text);
    background: color-mix(in srgb, var(--blue) 14%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
</style>