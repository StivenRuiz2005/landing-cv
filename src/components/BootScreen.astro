---
// Pantalla de arranque: una vez por sesión, saltable.
// Para verla siempre al desarrollar:  /?boot   o   /en/?boot
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].boot;
---

<script is:inline>
  (function () {
    var r = document.documentElement;
    try {
      var force = location.search.indexOf('boot') !== -1;
      if (force) sessionStorage.removeItem('booted');
      var skip =
        !force && (
          sessionStorage.getItem('booted') === '1' ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          localStorage.getItem('motion') === 'off'
        );
      if (skip) r.classList.add('boot-done');
    } catch (e) {
      r.classList.add('boot-done');
    }
  })();
</script>

<div id="boot" class="boot" role="dialog" aria-modal="true" aria-label={t.aria}>
  <div class="boot-inner">
    <p class="boot-logo" aria-hidden="true">CARLOS.DEV</p>
    <p class="boot-sub" aria-hidden="true">SYSTEM v1.0 · PLAYER ONE</p>

    <ul id="boot-lines" class="boot-lines" aria-hidden="true"></ul>

    <div class="boot-bar" aria-hidden="true">
      <div id="boot-fill" class="boot-fill"></div>
    </div>
    <p id="boot-pct" class="boot-pct" aria-hidden="true">0%</p>

    <button id="boot-skip" type="button" class="boot-skip">{t.skip}</button>
  </div>
</div>

<style>
  .boot { display: none; }
  :global(.js:not(.boot-done)) .boot { display: flex; }
  :global(.js:not(.boot-done) body) { overflow: hidden; }

  .boot {
    position: fixed;
    inset: 0;
    z-index: 200;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background:
      repeating-linear-gradient(to bottom, rgba(255,255,255,0.03) 0 2px, transparent 2px 4px),
      radial-gradient(ellipse at center, #0a1440 0%, #050b1f 70%);
    color: #22d3ee;
    font-family: "Press Start 2P", cursive;
    transition: opacity 0.4s ease;
  }
  .boot.leaving { opacity: 0; pointer-events: none; }

  .boot-inner { width: min(30rem, 100%); }

  .boot-logo {
    font-size: clamp(1.5rem, 6vw, 2.25rem);
    color: #60a5fa;
    text-shadow: 0 0 24px rgba(34, 211, 238, 0.7);
    margin-bottom: 0.75rem;
  }
  .boot-sub { font-size: 0.6rem; color: #b6c4e6; margin-bottom: 2rem; }

  .boot-lines {
    min-height: 7.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.6rem;
    line-height: 2.2;
    list-style: none;
    padding: 0;
  }
  .boot-lines :global(li) { animation: boot-in 0.25s ease-out both; }
  .boot-lines :global(li)::before { content: "> "; color: #8b5cf6; }
  @keyframes boot-in { from { opacity: 0; transform: translateX(-8px); } }

  .boot-bar {
    height: 18px;
    border: 3px solid #3b82f6;
    background: #050b1f;
    padding: 2px;
  }
  .boot-fill {
    height: 100%;
    width: 0;
    background: repeating-linear-gradient(90deg, #22d3ee 0 10px, #3b82f6 10px 14px);
    transition: width 0.35s steps(8);
  }
  .boot-pct { margin-top: 0.75rem; font-size: 0.65rem; text-align: right; }

  .boot-skip {
    margin-top: 2rem;
    min-height: 44px;
    padding: 0.6rem 1rem;
    font-family: inherit;
    font-size: 0.6rem;
    color: #eef4ff;
    background: transparent;
    border: 2px solid #3b82f6;
    cursor: pointer;
  }
  .boot-skip:hover { background: rgba(59, 130, 246, 0.2); }
</style>

<script>
  import { t } from '../i18n/client';

  const root = document.documentElement;
  const boot = document.getElementById('boot');

  if (boot && !root.classList.contains('boot-done')) {
    const linesEl = document.getElementById('boot-lines')!;
    const fill = document.getElementById('boot-fill')!;
    const pct = document.getElementById('boot-pct')!;
    const skip = document.getElementById('boot-skip')!;

    const lines: string[] = t.boot.lines;

    let done = false;
    const timers: number[] = [];

    function finish() {
      if (done) return;
      done = true;
      timers.forEach(clearTimeout);
      try { sessionStorage.setItem('booted', '1'); } catch {}
      boot!.classList.add('leaving');
      setTimeout(() => root.classList.add('boot-done'), 400);
    }

    skip.focus();
    skip.addEventListener('click', finish);
    boot.addEventListener('click', finish);
    document.addEventListener('keydown', (e) => {
      if (!done && e.key === 'Escape') finish();
    });

    lines.forEach((text, i) => {
      timers.push(
        window.setTimeout(() => {
          const li = document.createElement('li');
          li.textContent = text;
          linesEl.appendChild(li);
          const p = Math.round(((i + 1) / lines.length) * 100);
          fill.style.width = `${p}%`;
          pct.textContent = `${p}%`;
          if (i === lines.length - 1) timers.push(window.setTimeout(finish, 600));
        }, 350 + i * 450)
      );
    });
  }
</script>