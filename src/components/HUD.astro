---
import { ui, paths, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const n = t.nav;

const links = [
  { id: 'about', label: n.about, mLabel: n.about, icon: '📖' },
  { id: 'skills', label: n.skills, mLabel: n.skills, icon: '⚔️' },
  { id: 'experience', label: n.quests, mLabel: n.mQuests, icon: '🎯' },
  { id: 'projects', label: n.projects, mLabel: n.projects, icon: '🎮' },
  { id: 'achievements', label: n.trophies, mLabel: n.trophies, icon: '🏆' },
  { id: 'contact', label: n.contact, mLabel: n.contact, icon: '💬' },
];

const otherLang = n.switchLang as Lang;
---

<nav id="hud" class="fixed top-0 left-0 right-0 z-40 transition-transform duration-300" aria-label={n.aria}>
  <div class="glass-panel border-x-0 border-t-0">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between gap-4">

        <!-- Izquierda: logo + nivel -->
        <div class="flex items-center gap-4">
          <a
            href="#hero"
            class="flex min-h-[44px] items-center font-pixel text-xs text-game-cyan transition-colors hover:text-game-cyan-light sm:text-sm"
            aria-label={n.home}
          >
            <span class="hidden sm:inline">CARLOS.DEV</span>
            <span class="sm:hidden" aria-hidden="true">CR</span>
          </a>
          <div class="hidden items-center gap-2 text-xs md:flex" aria-hidden="true">
            <span class="font-pixel text-game-purple">LVL</span>
            <span class="font-bold text-ink" data-level>1</span>
          </div>
        </div>

        <!-- Centro: enlaces -->
        <div class="hidden items-center gap-1 md:flex lg:gap-2">
          {links.map((l) => <a href={`#${l.id}`} class="nav-link">{l.label}</a>)}
        </div>

        <!-- Derecha: XP + controles -->
        <div class="flex items-center gap-2 sm:gap-3">

          <div class="hidden w-32 flex-col gap-1 xl:flex">
            <div class="flex items-center justify-between">
              <span class="font-pixel text-xs text-game-cyan">XP</span>
              <span id="scroll-percentage" class="text-xs font-bold text-ink">0%</span>
            </div>
            <div
              class="h-2 overflow-hidden border border-game-blue/60 bg-game-dark-light"
              role="progressbar"
              aria-label={n.progress}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              id="scroll-progressbar"
            >
              <div
                id="scroll-progress-bar"
                class="h-full bg-gradient-to-r from-game-blue via-game-cyan to-game-purple"
                style="width: 0%"
              ></div>
            </div>
          </div>

          <!-- Descargar CV -->
          <a
            href={t.cvFile}
            download={t.cvFile.slice(1)}
            data-cv
            class="icon-btn hidden lg:inline-flex"
            title={n.cv}
          >
            <span class="sr-only">{n.cv}</span>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" />
            </svg>
          </a>

          <!-- Cambiar idioma: es un enlace porque navega a otra página -->
          <a
            id="lang-switch"
            href={paths[otherLang]}
            hreflang={otherLang}
            lang={otherLang}
            class="icon-btn font-pixel text-[0.6rem]"
            title={n.switchName}
          >
            <span aria-hidden="true">{n.switchCode}</span>
            <span class="sr-only">{n.switchName}</span>
          </a>

          <!-- Pausar animaciones -->
          <button id="motion-toggle" type="button" class="icon-btn motion-btn">
            <span class="sr-only">{t.a11y.pause}</span>
            <svg class="motion-icon-pause h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
            </svg>
            <svg class="motion-icon-play h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            <span id="motion-text" class="hidden font-pixel text-[0.55rem] xl:inline" aria-hidden="true">{t.a11y.animOn}</span>
          </button>

          <!-- Tema -->
          <button id="theme-toggle" type="button" class="icon-btn" aria-pressed="true">
            <span class="sr-only">{t.a11y.themeToggle}</span>
            <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- Menú móvil -->
          <button
            id="mobile-menu-toggle"
            type="button"
            class="icon-btn md:hidden"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="sr-only">{n.menuOpen}</span>
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Menú móvil -->
    <div id="mobile-menu" class="hidden border-t-2 border-game-blue/40 md:hidden">
      <div class="space-y-2 px-4 py-4">
        {links.map((l) => (
          <a href={`#${l.id}`} class="mobile-nav-link"><span aria-hidden="true">{l.icon}</span> {l.mLabel}</a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  import { t } from '../i18n/client';

  const hud = document.getElementById('hud');
  const bar = document.getElementById('scroll-progress-bar');
  const pct = document.getElementById('scroll-percentage');
  const progressbar = document.getElementById('scroll-progressbar');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll<HTMLAnchorElement>('.nav-link, .mobile-nav-link');
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  const langSwitch = document.getElementById('lang-switch') as HTMLAnchorElement | null;

  let lastY = window.scrollY;

  function updateProgress() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min((window.scrollY / max) * 100, 100) : 0;
    const rounded = Math.round(p);
    if (bar) bar.style.width = `${p}%`;
    if (pct) pct.textContent = `${rounded}%`;
    progressbar?.setAttribute('aria-valuenow', String(rounded));
  }

  function updateActive() {
    let current = '';
    sections.forEach((s) => {
      if (window.scrollY >= s.offsetTop - 120) current = s.id;
    });
    links.forEach((a) => {
      const match = a.getAttribute('href') === `#${current}`;
      a.classList.toggle('active', match);
      if (match) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
  }

  function onScroll() {
    const y = window.scrollY;
    const menuOpen = toggle?.getAttribute('aria-expanded') === 'true';
    const focusInside = hud?.contains(document.activeElement);
    if (hud) {
      const hide = y > lastY && y > 120 && !menuOpen && !focusInside;
      hud.style.transform = hide ? 'translateY(-100%)' : 'translateY(0)';
    }
    lastY = y;
    updateProgress();
    updateActive();
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', updateProgress);
  hud?.addEventListener('focusin', () => {
    if (hud) hud.style.transform = 'translateY(0)';
  });

  function setMenu(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    const label = toggle?.querySelector('.sr-only');
    if (label) label.textContent = open ? t.nav.menuClose : t.nav.menuOpen;
  }

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  // Al cambiar de idioma, conserva la sección en la que estás
  langSwitch?.addEventListener('click', () => {
    const base = (langSwitch.getAttribute('href') || '/').split('#')[0];
    langSwitch.setAttribute('href', base + window.location.hash);
  });

  updateProgress();
  updateActive();
</script>