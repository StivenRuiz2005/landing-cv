---
import { ui, type Lang } from '../i18n/ui';
import { getData } from '../i18n/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = t.contact;
const { personal } = getData(lang);

const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

const githubUser = personal.github.split('/').filter(Boolean).pop();
const gitlabUser = personal.gitlab.split('/').filter(Boolean).pop();
const linkedinUser = personal.linkedin.split('/').filter(Boolean).pop();
---

<section id="contact" class="section-container bg-game-dark-light/40" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-6xl">

    <div class="reveal">
      <h2 id="contact-heading" class="heading-pixel mb-6">
        <span aria-hidden="true">📨</span> {c.heading} <span aria-hidden="true">📨</span>
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-muted">{c.intro}</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-5">

      <!-- ============ CANALES ============ -->
      <div class="reveal space-y-4 lg:col-span-2">
        <h3 class="font-pixel text-xs text-game-cyan">{c.channels}</h3>

        <!-- Correo -->
        <div class="channel glass-panel rounded-xl p-5">
          <p class="mb-1 font-pixel text-[0.6rem] text-game-purple">{c.emailLabel}</p>
          <p class="mb-3 break-all font-semibold text-ink" id="email-text">{personal.email}</p>

          <div class="flex flex-wrap items-center gap-3">
            <button type="button" id="copy-email" class="copy-btn" data-email={personal.email}>
              <span id="copy-label">{c.copy}</span>
            </button>
            <a
              href={`mailto:${personal.email}`}
              class="inline-flex min-h-[44px] items-center text-sm font-semibold text-game-cyan underline underline-offset-4 hover:text-game-cyan-light"
            >
              {c.openMail}
            </a>
          </div>
        </div>

        <!-- CV -->
        <a
          href={t.cvFile}
          download={t.cvFile.slice(1)}
          data-cv
          class="channel link-card glass-panel rounded-xl p-5"
        >
          <span class="text-3xl" aria-hidden="true">📄</span>
          <span class="flex-1">
            <span class="block font-pixel text-[0.6rem] text-game-purple">{c.cvLabel}</span>
            <span class="block font-semibold text-ink">{c.cvText}</span>
          </span>
          <span class="text-game-cyan" aria-hidden="true">↓</span>
        </a>

        <!-- GitHub -->
        <a href={personal.github} target="_blank" rel="noopener noreferrer" class="channel link-card glass-panel rounded-xl p-5">
          <span class="text-3xl" aria-hidden="true">🐙</span>
          <span class="flex-1">
            <span class="block font-pixel text-[0.6rem] text-game-purple">GITHUB</span>
            <span class="block font-semibold text-ink">@{githubUser}</span>
          </span>
          <span class="text-game-cyan" aria-hidden="true">↗</span>
          <span class="sr-only">{t.newTab}</span>
        </a>

        <!-- GitLab -->
        <a href={personal.gitlab} target="_blank" rel="noopener noreferrer" class="channel link-card glass-panel rounded-xl p-5">
          <span class="text-3xl" aria-hidden="true">🦊</span>
          <span class="flex-1">
            <span class="block font-pixel text-[0.6rem] text-game-purple">GITLAB</span>
            <span class="block font-semibold text-ink">@{gitlabUser}</span>
          </span>
          <span class="text-game-cyan" aria-hidden="true">↗</span>
          <span class="sr-only">{t.newTab}</span>
        </a>

        <!-- LinkedIn -->
        <a href={personal.linkedin} target="_blank" rel="noopener noreferrer" class="channel link-card glass-panel rounded-xl p-5">
          <span class="text-3xl" aria-hidden="true">💼</span>
          <span class="flex-1">
            <span class="block font-pixel text-[0.6rem] text-game-purple">LINKEDIN</span>
            <span class="block font-semibold text-ink">{linkedinUser}</span>
          </span>
          <span class="text-game-cyan" aria-hidden="true">↗</span>
          <span class="sr-only">{t.newTab}</span>
        </a>
      </div>

      <!-- ============ FORMULARIO ============ -->
      <div class="reveal lg:col-span-3">
        <form
          id="contact-form"
          class="glass-panel space-y-5 rounded-xl p-6 sm:p-8"
          novalidate
          data-key={formKey}
          data-to={personal.email}
          aria-labelledby="form-title"
        >
          <h3 id="form-title" class="font-pixel text-xs text-game-cyan">{c.formTitle}</h3>

          <div class="hp" aria-hidden="true">
            <label>{c.honeypot}<input type="text" name="botcheck" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="field">
            <label for="f-name">{c.name}</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="err-name" />
            <p id="err-name" class="err" role="alert"></p>
          </div>

          <div class="field">
            <label for="f-email">{c.yourEmail}</label>
            <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="err-email" />
            <p id="err-email" class="err" role="alert"></p>
          </div>

          <div class="field">
            <label for="f-message">{c.message}</label>
            <textarea id="f-message" name="message" rows="5" required aria-describedby="err-message hint-message"></textarea>
            <p id="hint-message" class="hint">{c.hint}</p>
            <p id="err-message" class="err" role="alert"></p>
          </div>

          <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <button type="submit" id="send-btn" class="btn-pixel">
              <span aria-hidden="true">▶</span>
              <span id="send-label">{c.send}</span>
            </button>
            <p id="form-status" class="text-sm font-semibold" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .channel { display: block; }

  .link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .link-card:hover { transform: translateX(4px); border-color: var(--accent); }

  .copy-btn {
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 2px solid var(--accent);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .copy-btn:hover { background: color-mix(in srgb, var(--accent) 22%, transparent); }
  .copy-btn.ok { color: var(--btn-text); background: var(--btn); border-color: var(--btn); }

  .field label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.7rem 0.9rem;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 0.5rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .field textarea { resize: vertical; }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .field input[aria-invalid="true"],
  .field textarea[aria-invalid="true"] { border-color: #ef4444; }

  .hint { margin-top: 0.3rem; font-size: 0.8rem; color: var(--muted); }
  .err { margin-top: 0.3rem; font-size: 0.85rem; font-weight: 600; color: #dc2626; }
  :global(.dark) .err { color: #fca5a5; }
  .err:empty { display: none; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  #send-btn:disabled { opacity: 0.6; cursor: wait; }
  #form-status.ok { color: var(--accent); }
  #form-status.bad { color: #dc2626; }
  :global(.dark) #form-status.bad { color: #fca5a5; }
</style>

<script>
  import { t, fmt } from '../i18n/client';

  const c = t.contact;

  const live = (msg: string) => {
    const el = document.getElementById('live-region');
    if (el) el.textContent = msg;
  };

  /* ---------- Copiar correo ---------- */
  const copyBtn = document.getElementById('copy-email') as HTMLButtonElement | null;
  const copyLabel = document.getElementById('copy-label');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      const range = document.createRange();
      range.selectNodeContents(document.getElementById('email-text')!);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
      document.execCommand('copy');
      sel?.removeAllRanges();
    }
    if (copyLabel) copyLabel.textContent = c.copied;
    copyBtn.classList.add('ok');
    live(c.copiedLive);
    setTimeout(() => {
      if (copyLabel) copyLabel.textContent = c.copy;
      copyBtn.classList.remove('ok');
    }, 2200);
  });

  /* ---------- Formulario ---------- */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const status = document.getElementById('form-status')!;
    const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
    const sendLabel = document.getElementById('send-label')!;

    const fields = {
      name: form.elements.namedItem('name') as HTMLInputElement,
      email: form.elements.namedItem('email') as HTMLInputElement,
      message: form.elements.namedItem('message') as HTMLTextAreaElement,
    };

    const validators: Record<keyof typeof fields, (v: string) => string> = {
      name: (v) => (v.trim().length < 2 ? c.errName : ''),
      email: (v) =>
        !v.trim()
          ? c.errEmailEmpty
          : !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim())
          ? c.errEmailFormat
          : '',
      message: (v) => (v.trim().length < 10 ? c.errMessage : ''),
    };

    function check(key: keyof typeof fields): boolean {
      const input = fields[key];
      const msg = validators[key](input.value);
      const err = document.getElementById(`err-${key}`)!;
      err.textContent = msg;
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      return !msg;
    }

    (Object.keys(fields) as (keyof typeof fields)[]).forEach((key) => {
      fields[key].addEventListener('blur', () => check(key));
      fields[key].addEventListener('input', () => {
        if (fields[key].getAttribute('aria-invalid') === 'true') check(key);
      });
    });

    function setStatus(text: string, kind: 'ok' | 'bad' | '') {
      status.textContent = text;
      status.className = `text-sm font-semibold ${kind}`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('', '');

      const results = (Object.keys(fields) as (keyof typeof fields)[]).map((k) => ({ k, ok: check(k) }));
      const firstBad = results.find((r) => !r.ok);
      if (firstBad) {
        fields[firstBad.k].focus();
        return;
      }

      const bot = (form.elements.namedItem('botcheck') as HTMLInputElement).value;
      if (bot) { setStatus(c.sent, 'ok'); return; }

      const payload = {
        name: fields.name.value.trim(),
        email: fields.email.value.trim(),
        message: fields.message.value.trim(),
      };
      const key = form.dataset.key;
      const to = form.dataset.to ?? '';
      const subjectText = fmt(c.subject, { name: payload.name });

      sendBtn.disabled = true;
      sendLabel.textContent = c.sending;

      if (!key) {
        const subject = encodeURIComponent(subjectText);
        const body = encodeURIComponent(`${payload.message}\n\n— ${payload.name} (${payload.email})`);
        window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
        setStatus(c.mailOpened, 'ok');
        live(c.mailOpenedLive);
        sendBtn.disabled = false;
        sendLabel.textContent = c.send;
        return;
      }

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: key,
            subject: subjectText,
            from_name: 'Portfolio',
            ...payload,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error('fail');

        form.reset();
        (Object.keys(fields) as (keyof typeof fields)[]).forEach((k) =>
          fields[k].setAttribute('aria-invalid', 'false')
        );
        setStatus(c.sent, 'ok');
        window.dispatchEvent(new CustomEvent('game:award', {
          detail: { id: 'message', xp: 200, label: t.game.message },
        }));
      } catch {
        setStatus(c.failed, 'bad');
      } finally {
        sendBtn.disabled = false;
        sendLabel.textContent = c.send;
      }
    });
  }
</script>