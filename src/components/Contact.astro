---
import personalData from '../data/personal.json';

// Clave pública de Web3Forms (opcional). Se crea gratis en https://web3forms.com
// y se pone en un archivo .env como:  PUBLIC_WEB3FORMS_KEY=tu_clave
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

const githubUser = personalData.github.split('/').filter(Boolean).pop();
const gitlabUser = personalData.gitlab.split('/').filter(Boolean).pop();
const linkedinUser = personalData.linkedin.split('/').filter(Boolean).pop();
---

<section id="contact" class="section-container bg-game-dark-light/40" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-6xl">

    <div class="reveal">
      <h2 id="contact-heading" class="heading-pixel mb-6">
        <span aria-hidden="true">📨</span> NUEVA MISIÓN <span aria-hidden="true">📨</span>
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-muted">
        ¿Tienes una oferta, un proyecto o una idea? Escríbeme y te respondo lo antes posible.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-5">

      <!-- ============ CANALES ============ -->
      <div class="reveal space-y-4 lg:col-span-2">
        <h3 class="font-pixel text-xs text-game-cyan">CANALES</h3>

        <!-- Correo -->
        <div class="channel glass-panel rounded-xl p-5">
          <p class="mb-1 font-pixel text-[0.6rem] text-game-purple">CORREO</p>
          <p class="mb-3 break-all font-semibold text-ink" id="email-text">{personalData.email}</p>

          <div class="flex flex-wrap items-center gap-3">
            <button
              type="button"
              id="copy-email"
              class="copy-btn"
              data-email={personalData.email}
            >
              <span id="copy-label">Copiar correo</span>
            </button>
            <a
              href={`mailto:${personalData.email}`}
              class="inline-flex min-h-[44px] items-center text-sm font-semibold text-game-cyan underline underline-offset-4 hover:text-game-cyan-light"
            >
              Abrir app de correo
            </a>
          </div>
        </div>

        <!-- GitHub -->
        <a
          href={personalData.github}
          target="_blank"
          rel="noopener noreferrer"
          class="channel link-card glass-panel rounded-xl p-5"
        >
          <span class="text-3xl" aria-hidden="true">🐙</span>
          <span class="flex-1">
            <span class="block font-pixel text-[0.6rem] text-game-purple">GITHUB</span>
            <span class="block font-semibold text-ink">@{githubUser}</span>
          </span>
          <span class="text-game-cyan" aria-hidden="true">↗</span>
          <span class="sr-only">(abre en una pestaña nueva)</span>
        </a>

        <!-- GitLab -->
        <a
          href={personalData.gitlab}
          target="_blank"
          rel="noopener noreferrer"
          class="channel link-card glass-panel rounded-xl p-5"
        >
          <span class="text-3xl" aria-hidden="true">🦊</span>
          <span class="flex-1">
            <span class="block font-pixel text-[0.6rem] text-game-purple">GITLAB</span>
            <span class="block font-semibold text-ink">@{gitlabUser}</span>
          </span>
          <span class="text-game-cyan" aria-hidden="true">↗</span>
          <span class="sr-only">(abre en una pestaña nueva)</span>
        </a>
        
        <!-- LinkedIn -->
        <a
        href={personalData.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="channel link-card glass-panel rounded-xl p-5"
        >
        <span class="text-3xl" aria-hidden="true">💼</span>
        <span class="flex-1">
            <span class="block font-pixel text-[0.6rem] text-game-purple">LINKEDIN</span>
            <span class="block font-semibold text-ink">{linkedinUser}</span>
        </span>
        <span class="text-game-cyan" aria-hidden="true">↗</span>
        <span class="sr-only">(abre en una pestaña nueva)</span>
        </a>
      </div>



      <!-- ============ FORMULARIO ============ -->
      <div class="reveal lg:col-span-3">
        <form
          id="contact-form"
          class="glass-panel space-y-5 rounded-xl p-6 sm:p-8"
          novalidate
          data-key={formKey}
          data-to={personalData.email}
          aria-labelledby="form-title"
        >
          <h3 id="form-title" class="font-pixel text-xs text-game-cyan">ENVIAR MENSAJE</h3>

          <!-- Anti-spam: los humanos no ven este campo -->
          <div class="hp" aria-hidden="true">
            <label>No llenar<input type="text" name="botcheck" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="field">
            <label for="f-name">Nombre</label>
            <input
              id="f-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              aria-describedby="err-name"
            />
            <p id="err-name" class="err" role="alert"></p>
          </div>

          <div class="field">
            <label for="f-email">Tu correo</label>
            <input
              id="f-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              aria-describedby="err-email"
            />
            <p id="err-email" class="err" role="alert"></p>
          </div>

          <div class="field">
            <label for="f-message">Mensaje</label>
            <textarea
              id="f-message"
              name="message"
              rows="5"
              required
              aria-describedby="err-message hint-message"
            ></textarea>
            <p id="hint-message" class="hint">Mínimo 10 caracteres.</p>
            <p id="err-message" class="err" role="alert"></p>
          </div>

          <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <button type="submit" id="send-btn" class="btn-pixel">
              <span aria-hidden="true">▶</span>
              <span id="send-label">ENVIAR MENSAJE</span>
            </button>
            <p id="form-status" class="text-sm font-semibold" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .channel {
    display: block;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .link-card:hover {
    transform: translateX(4px);
    border-color: var(--accent);
  }

  .copy-btn {
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 2px solid var(--accent);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .copy-btn:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .copy-btn.ok {
    color: var(--btn-text);
    background: var(--btn);
    border-color: var(--btn);
  }

  /* Campos */
  .field label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.7rem 0.9rem;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 0.5rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .field textarea { resize: vertical; }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .field input[aria-invalid="true"],
  .field textarea[aria-invalid="true"] {
    border-color: #ef4444;
  }

  .hint { margin-top: 0.3rem; font-size: 0.8rem; color: var(--muted); }
  .err {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #dc2626;
  }
  :global(.dark) .err { color: #fca5a5; }
  .err:empty { display: none; }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  #send-btn:disabled { opacity: 0.6; cursor: wait; }
  #form-status.ok { color: var(--accent); }
  #form-status.bad { color: #dc2626; }
  :global(.dark) #form-status.bad { color: #fca5a5; }
</style>

<script>
  const live = (msg: string) => {
    const el = document.getElementById('live-region');
    if (el) el.textContent = msg;
  };

  /* ---------- Copiar correo ---------- */
  const copyBtn = document.getElementById('copy-email') as HTMLButtonElement | null;
  const copyLabel = document.getElementById('copy-label');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      // Respaldo para navegadores sin permiso de portapapeles
      const range = document.createRange();
      range.selectNodeContents(document.getElementById('email-text')!);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
      document.execCommand('copy');
      sel?.removeAllRanges();
    }
    if (copyLabel) copyLabel.textContent = '¡Copiado!';
    copyBtn.classList.add('ok');
    live('Correo copiado al portapapeles');
    setTimeout(() => {
      if (copyLabel) copyLabel.textContent = 'Copiar correo';
      copyBtn.classList.remove('ok');
    }, 2200);
  });

  /* ---------- Formulario ---------- */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const status = document.getElementById('form-status')!;
    const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
    const sendLabel = document.getElementById('send-label')!;

    const fields = {
      name: form.elements.namedItem('name') as HTMLInputElement,
      email: form.elements.namedItem('email') as HTMLInputElement,
      message: form.elements.namedItem('message') as HTMLTextAreaElement,
    };

    const validators: Record<keyof typeof fields, (v: string) => string> = {
      name: (v) => (v.trim().length < 2 ? 'Escribe tu nombre.' : ''),
      email: (v) =>
        !v.trim()
          ? 'Escribe tu correo.'
          : !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim())
          ? 'Revisa el correo: debe verse como nombre@dominio.com'
          : '',
      message: (v) => (v.trim().length < 10 ? 'El mensaje debe tener al menos 10 caracteres.' : ''),
    };

    function check(key: keyof typeof fields): boolean {
      const input = fields[key];
      const msg = validators[key](input.value);
      const err = document.getElementById(`err-${key}`)!;
      err.textContent = msg;
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      return !msg;
    }

    (Object.keys(fields) as (keyof typeof fields)[]).forEach((key) => {
      fields[key].addEventListener('blur', () => check(key));
      fields[key].addEventListener('input', () => {
        if (fields[key].getAttribute('aria-invalid') === 'true') check(key);
      });
    });

    function setStatus(text: string, kind: 'ok' | 'bad' | '') {
      status.textContent = text;
      status.className = `text-sm font-semibold ${kind}`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('', '');

      const results = (Object.keys(fields) as (keyof typeof fields)[]).map((k) => ({ k, ok: check(k) }));
      const firstBad = results.find((r) => !r.ok);
      if (firstBad) {
        fields[firstBad.k].focus();
        return;
      }

      // Si un bot llenó el campo oculto, fingimos éxito y no enviamos
      const bot = (form.elements.namedItem('botcheck') as HTMLInputElement).value;
      if (bot) { setStatus('¡Mensaje enviado!', 'ok'); return; }

      const payload = {
        name: fields.name.value.trim(),
        email: fields.email.value.trim(),
        message: fields.message.value.trim(),
      };
      const key = form.dataset.key;
      const to = form.dataset.to ?? '';

      sendBtn.disabled = true;
      sendLabel.textContent = 'ENVIANDO...';

      // Sin clave configurada: abrimos el correo con el mensaje ya redactado
      if (!key) {
        const subject = encodeURIComponent(`Contacto desde tu portafolio – ${payload.name}`);
        const body = encodeURIComponent(`${payload.message}\n\n— ${payload.name} (${payload.email})`);
        window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
        setStatus('Se abrió tu app de correo con el mensaje listo para enviar.', 'ok');
        live('Se abrió tu app de correo con el mensaje listo');
        sendBtn.disabled = false;
        sendLabel.textContent = 'ENVIAR MENSAJE';
        return;
      }

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: key,
            subject: `Contacto desde tu portafolio – ${payload.name}`,
            from_name: 'Portafolio',
            ...payload,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error('fail');

        form.reset();
        (Object.keys(fields) as (keyof typeof fields)[]).forEach((k) =>
          fields[k].setAttribute('aria-invalid', 'false')
        );
        setStatus('¡Mensaje enviado! Te responderé pronto.', 'ok');
        window.dispatchEvent(new CustomEvent('game:award', {
          detail: { id: 'message', xp: 200, label: '📨 Misión aceptada: mensaje enviado' },
        }));
      } catch {
        setStatus('No se pudo enviar. Escríbeme directamente al correo.', 'bad');
      } finally {
        sendBtn.disabled = false;
        sendLabel.textContent = 'ENVIAR MENSAJE';
      }
    });
  }
</script>