---
// Sistema de XP y niveles. Los textos vienen del idioma activo.
---

<div
  id="toasts"
  class="pointer-events-none fixed bottom-4 right-4 z-[60] flex w-[min(20rem,calc(100vw-2rem))] flex-col items-end gap-3"
  role="status"
  aria-live="polite"
  aria-atomic="true"
></div>

<style>
  :global(.toast) {
    width: 100%;
    padding: 0.7rem 0.9rem;
    color: var(--text);
    background: var(--surface);
    border: 3px solid var(--accent);
    box-shadow: 4px 4px 0 var(--shadow-hard), var(--glow);
    animation: toast-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  :global(.toast.levelup) { border-color: var(--purple); }
  :global(.toast .t-title) {
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  :global(.toast.levelup .t-title) { color: var(--purple); }
  :global(.toast .t-body) { font-size: 0.8rem; color: var(--muted); }
  :global(.toast.out) {
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  @keyframes toast-in { from { opacity: 0; transform: translateX(40px); } }
</style>

<script>
  import { t, fmt } from '../i18n/client';

  const KEY = 'game';
  const XP_PER_SECTION = 150;
  const QUIET_MS = 400;
  const WARMUP_MS = 1000;
  const SHOW_MS = 3000;
  const GROUP_MS = 250;

  const SECTIONS: Record<string, string> = t.game.sections;

  type State = { xp: number; seen: string[] };
  let state: State = { xp: 0, seen: [] };
  try {
    const raw = localStorage.getItem(KEY);
    if (raw) state = JSON.parse(raw);
  } catch {}

  const levelOf = (xp: number) => 1 + Math.floor(xp / 100);
  const startedAt = performance.now();

  function save() {
    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {}
  }

  function render() {
    document.querySelectorAll<HTMLElement>('[data-level]').forEach((el) => {
      el.textContent = String(levelOf(state.xp));
    });
    document.querySelectorAll<HTMLElement>('[data-xp]').forEach((el) => {
      el.textContent = String(state.xp);
    });
  }

  /* ---------- Cola de avisos ---------- */
  type Toast = { title: string; body: string; levelup?: boolean; urgent?: boolean };
  const queue: Toast[] = [];
  let showing = false;
  let lastScroll = 0;

  window.addEventListener('scroll', () => { lastScroll = performance.now(); }, { passive: true });

  const canShow = () =>
    performance.now() - startedAt > WARMUP_MS &&
    performance.now() - lastScroll > QUIET_MS;

  function pump() {
    if (showing || queue.length === 0) return;
    const next = queue[0];
    if (!next.urgent && !canShow()) {
      setTimeout(pump, 200);
      return;
    }
    const item = queue.shift()!;
    const box = document.getElementById('toasts');
    if (!box) return;
    showing = true;

    const el = document.createElement('div');
    el.className = `toast${item.levelup ? ' levelup' : ''}`;
    const title = document.createElement('p');
    title.className = 't-title';
    title.textContent = item.title;
    const body = document.createElement('p');
    body.className = 't-body';
    body.textContent = item.body;
    el.append(title, body);
    box.replaceChildren(el);

    setTimeout(() => {
      el.classList.add('out');
      setTimeout(() => {
        el.remove();
        showing = false;
        pump();
      }, 260);
    }, SHOW_MS);
  }

  function notify(item: Toast) {
    if (item.urgent) queue.unshift(item);
    else queue.push(item);
    pump();
  }

  /* ---------- Otorgar XP ---------- */
  let pending = { xp: 0, labels: [] as string[] };
  let flushTimer: number | undefined;

  function flush() {
    const { xp, labels } = pending;
    pending = { xp: 0, labels: [] };
    if (xp === 0) return;
    const before = levelOf(state.xp - xp);
    const after = levelOf(state.xp);
    notify({
      title: `+${xp} XP`,
      body: labels.length === 1 ? labels[0] : fmt(t.game.many, { n: labels.length }),
    });
    if (after > before) {
      notify({ title: t.game.levelup, body: fmt(t.game.nowLevel, { n: after }), levelup: true });
    }
  }

  function award(id: string, xp: number, label: string, urgent = false) {
    if (state.seen.includes(id)) {
      if (urgent) notify({ title: t.game.already, body: label, urgent: true });
      return;
    }
    const before = levelOf(state.xp);
    state.seen.push(id);
    state.xp += xp;
    save();
    render();

    if (urgent) {
      notify({ title: `+${xp} XP`, body: label, urgent: true });
      const after = levelOf(state.xp);
      if (after > before) {
        notify({ title: t.game.levelup, body: fmt(t.game.nowLevel, { n: after }), levelup: true, urgent: true });
      }
    } else {
      pending.xp += xp;
      pending.labels.push(label);
      clearTimeout(flushTimer);
      flushTimer = window.setTimeout(flush, GROUP_MS);
    }

    const all = Object.keys(SECTIONS).every((s) => state.seen.includes(s));
    if (all && !state.seen.includes('explorer')) {
      setTimeout(() => award('explorer', 100, t.game.explorer), 1200);
    }
  }

  render();

  /* ---------- Descubrir secciones ---------- */
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        io.unobserve(entry.target);
        award(id, XP_PER_SECTION, fmt(t.game.discovered, { name: SECTIONS[id] }));
      });
    },
    { threshold: 0, rootMargin: '0px 0px -35% 0px' }
  );
  Object.keys(SECTIONS).forEach((id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });

  /* ---------- Eventos externos (Konami, CV, mensaje) ---------- */
  window.addEventListener('game:award', (e) => {
    const d = (e as CustomEvent).detail;
    award(d.id, d.xp, d.label, !!d.urgent);
  });
</script>