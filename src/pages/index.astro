---
import BaseLayout from '../layouts/BaseLayout.astro';
import BootScreen from '../components/BootScreen.astro';
import HUD from '../components/HUD.astro';
import Hero from '../components/Hero.astro';
import GameSystem from '../components/GameSystem.astro';
import Effects from '../components/Effects.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Achievements from '../components/Achievements.astro';
import personalData from '../data/personal.json';
import Contact from '../components/Contact.astro';

const year = new Date().getFullYear();
---

<BaseLayout
  title={`${personalData.name} | Full Stack Developer`}
  description={personalData.bio}
>
  <BootScreen />
  <HUD />
  <Hero />
  <GameSystem />
  <Effects />

  <!-- ABOUT -->
  <section id="about" class="section-container" aria-labelledby="about-heading">
    <div class="reveal mx-auto max-w-4xl">
      <h2 id="about-heading" class="heading-pixel mb-12">
        <span class="text-game-purple" aria-hidden="true">←</span> SOBRE MI <span class="text-game-purple" aria-hidden="true">→</span>
      </h2>

      <div class="glass-panel rounded-xl p-6 sm:p-8">
        <p class="text-lg leading-relaxed text-muted">{personalData.bio}</p>

        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="stat-card">
            <div class="mb-2 text-3xl" aria-hidden="true">🎓</div>
            <h3 class="mb-1 font-pixel text-xs text-game-cyan">EDUCACIÓN</h3>
            <p class="text-sm text-ink">Universidad del Valle</p>
            <p class="text-xs text-muted">Ingeniería de Sistemas · Décimo semestre</p>
          </div>

          <div class="stat-card">
            <div class="mb-2 text-3xl" aria-hidden="true">💼</div>
            <h3 class="mb-1 font-pixel text-xs text-game-cyan">EXPERIENCIA</h3>
            <p class="text-sm text-ink">1+ año profesional</p>
            <p class="text-xs text-muted">Full Stack · Invessoft</p>
          </div>

          <div class="stat-card">
            <div class="mb-2 text-3xl" aria-hidden="true">🎯</div>
            <h3 class="mb-1 font-pixel text-xs text-game-cyan">ENFOQUE</h3>
            <p class="text-sm text-ink">Backend & APIs</p>
            <p class="text-xs text-muted">Datos, ML y Cloud</p>
          </div>

          <div class="stat-card">
            <div class="mb-2 text-3xl" aria-hidden="true">📍</div>
            <h3 class="mb-1 font-pixel text-xs text-game-cyan">UBICACIÓN</h3>
            <p class="text-sm text-ink">{personalData.location.split(',')[0]}</p>
            <p class="text-xs text-muted">Colombia</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Skills />
  <Experience />
  <Projects />
  <Achievements />
  <Contact />


  <!-- FOOTER -->
  <footer class="border-t-2 border-game-blue/40 py-8">
    <div class="mx-auto max-w-7xl px-4 text-center">
      <p class="mb-2 font-pixel text-xs text-game-cyan">THANKS FOR PLAYING</p>
      <p class="text-sm text-muted">
        © {year} {personalData.name}
      </p>
      <p class="mt-2 text-xs text-muted">
        Easter egg: prueba el código Konami <span aria-hidden="true">🎮</span>
      </p>
    </div>
  </footer>
</BaseLayout>