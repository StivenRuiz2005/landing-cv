---
import '../styles/global.css';
import { ui, paths, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { lang = 'es', title, description = ui[lang].meta.description } = Astro.props;
const t = ui[lang];

const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(paths[lang], site);
const urlEs = new URL(paths.es, site);
const urlEn = new URL(paths.en, site);
const socialImageURL = new URL('/og-image.png', site);
const otherLocale = lang === 'es' ? ui.en.meta.ogLocale : ui.es.meta.ogLocale;

// Textos para los scripts del navegador (se escapa "<" por seguridad)
const i18nJson = JSON.stringify(t).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Carlos Stiven Ruiz Rojas" />
    <meta name="keywords" content={t.meta.keywords} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={urlEs} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlEs} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={otherLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2563EB" />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />

    <!-- Tema y movimiento ANTES de pintar (sin parpadeo) -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored
            ? stored === 'dark'
            : !(window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches);
          root.classList.toggle('dark', dark);
          if (localStorage.getItem('motion') === 'off') root.classList.add('no-motion');
        } catch (e) {
          root.classList.add('dark');
        }
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Carlos Stiven Ruiz Rojas',
      url: canonicalURL.toString(),
      jobTitle: 'Full Stack Developer',
      description: t.meta.ldDescription,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Tuluá',
        addressRegion: 'Valle del Cauca',
        addressCountry: 'Colombia',
      },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad del Valle' },
      knowsAbout: ['JavaScript', 'TypeScript', 'Node.js', 'NestJS', 'Angular', 'React', 'Python', 'AWS', 'Docker', 'PostgreSQL'],
      sameAs: [
        'https://github.com/StivenRuiz2005',
        'https://gitlab.com/carlosruizrojas2005',
        'https://www.linkedin.com/in/stiven-ruiz',
      ],
    })} />

    <title>{title}</title>
  </head>

  <body class="relative min-h-screen overflow-x-hidden">
    <!-- Textos del idioma activo para los scripts -->
    <script type="application/json" id="i18n" is:inline set:html={i18nJson} />

    <a href="#main-content" class="skip-link">{t.skip}</a>

    <!-- Fondo decorativo -->
    <div class="fixed inset-0 -z-20 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 bg-gradient-to-br from-game-dark via-game-dark-light to-game-dark"></div>
      <div class="retro-grid opacity-40"></div>
      <div class="stars"></div>
      <div class="absolute top-0 left-1/4 h-96 w-96 rounded-full bg-game-blue/20 blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 h-96 w-96 rounded-full bg-game-purple/15 blur-3xl"></div>
    </div>

    <main id="main-content">
      <slot />
    </main>

    <div id="live-region" class="sr-only" role="status" aria-live="polite"></div>

    <script>
      import { t } from '../i18n/client';

      const root = document.documentElement;

      function announce(msg: string) {
        const el = document.getElementById('live-region');
        if (el) el.textContent = msg;
      }

      /* ---------- Tema ---------- */
      const themeBtn = document.getElementById('theme-toggle');
      themeBtn?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
      themeBtn?.addEventListener('click', () => {
        const dark = root.classList.toggle('dark');
        themeBtn.setAttribute('aria-pressed', String(dark));
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
        announce(dark ? t.a11y.themeDark : t.a11y.themeLight);
      });

      /* ---------- Pausar animaciones ---------- */
      const motionBtn = document.getElementById('motion-toggle') as HTMLButtonElement | null;
      const motionLabel = motionBtn?.querySelector('.sr-only');
      const motionText = document.getElementById('motion-text');
      const osReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function syncMotion() {
        if (!motionBtn) return;

        if (osReduce) {
          root.classList.add('no-motion');
          motionBtn.disabled = true;
          motionBtn.title = t.a11y.system;
          if (motionLabel) motionLabel.textContent = t.a11y.system;
          if (motionText) motionText.textContent = t.a11y.animSystem;
          return;
        }

        const paused = root.classList.contains('no-motion');
        const label = paused ? t.a11y.resume : t.a11y.pause;
        motionBtn.title = label;
        if (motionLabel) motionLabel.textContent = label;
        if (motionText) motionText.textContent = paused ? t.a11y.animOff : t.a11y.animOn;
      }

      syncMotion();

      motionBtn?.addEventListener('click', () => {
        const paused = root.classList.toggle('no-motion');
        try { localStorage.setItem('motion', paused ? 'off' : 'on'); } catch {}
        syncMotion();
        announce(paused ? t.a11y.motionPaused : t.a11y.motionOn);
      });

      /* ---------- Reveal al hacer scroll ---------- */
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (osReduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        items.forEach((el) => io.observe(el));
      }

      /* ---------- Konami Code ---------- */
      const konami = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
      let idx = 0;
      document.addEventListener('keydown', (e) => {
        const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
        if (k === konami[idx]) {
          idx++;
          if (idx === konami.length) {
            idx = 0;
            activateEasterEgg();
          }
        } else {
          idx = k === konami[0] ? 1 : 0;
        }
      });

      function activateEasterEgg() {
        window.dispatchEvent(new CustomEvent('game:award', {
          detail: { id: 'konami', xp: 500, label: t.game.konami, urgent: true },
        }));

        announce(t.konami.announce);
        const animate = !root.classList.contains('no-motion') && !osReduce;

        if (animate) {
          const colors = ['#22D3EE', '#8B5CF6', '#3B82F6', '#F59E0B'];
          for (let i = 0; i < 50; i++) {
            setTimeout(() => {
              const px = document.createElement('div');
              px.setAttribute('aria-hidden', 'true');
              px.style.cssText = `position:fixed;width:12px;height:12px;background:${colors[Math.floor(Math.random() * colors.length)]};left:${Math.random() * 100}vw;top:-20px;z-index:9999;pointer-events:none;border-radius:2px;`;
              const duration = 2000 + Math.random() * 3000;
              px.animate(
                [
                  { transform: 'translateY(0) rotate(0deg)', opacity: 1 },
                  { transform: `translateY(100vh) rotate(${Math.random() * 360}deg)`, opacity: 0 },
                ],
                { duration, easing: 'ease-in' }
              );
              document.body.appendChild(px);
              setTimeout(() => px.remove(), duration);
            }, i * 50);
          }
        }

        const box = document.createElement('div');
        box.setAttribute('aria-hidden', 'true');
        box.style.cssText = `position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:10000;background:rgba(10,20,64,.95);border:4px solid #22D3EE;padding:2rem;border-radius:1rem;text-align:center;font-family:'Press Start 2P',cursive;color:#22D3EE;box-shadow:0 0 40px rgba(34,211,238,.6);max-width:90vw;`;

        const icon = document.createElement('div');
        icon.style.cssText = 'font-size:2rem;margin-bottom:1rem';
        icon.textContent = '🏆';
        const title = document.createElement('div');
        title.style.cssText = 'font-size:.8rem;margin-bottom:.5rem;line-height:1.6';
        title.textContent = t.konami.title;
        const sub = document.createElement('div');
        sub.style.cssText = 'font-size:.6rem;color:#67E8F9';
        sub.textContent = t.konami.sub;
        box.append(icon, title, sub);

        document.body.appendChild(box);
        setTimeout(() => box.remove(), 3000);
      }
    </script>
  </body>
</html>